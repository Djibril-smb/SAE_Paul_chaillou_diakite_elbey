<Window x:Class="SAE_Paul.uc.FenetreChoixTailleProduit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Choisir une taille" Height="440" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FAF4EB">
    <StackPanel Margin="28">
        <TextBlock x:Name="LblTitre" Text="Recette"
                   FontFamily="Georgia" FontSize="22" FontWeight="Bold"
                   Foreground="#231F20" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock Text="Choisissez la taille :"
                   FontFamily="Georgia" FontSize="13" Foreground="#666" Margin="0,0,0,6"/>

        <ListBox x:Name="ListeTailles"
                 BorderBrush="#231F20" BorderThickness="1"
                 Background="White" SelectionMode="Single"
                 FontSize="14" Margin="0,0,0,15" MaxHeight="180">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,4" MinWidth="320">
                        <TextBlock FontFamily="Georgia" FontSize="14"
                                   HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Run Text="{Binding NbParts}"/>
                            <Run Text=" parts"/>
                        </TextBlock>
                        <TextBlock Text="{Binding Prix, StringFormat=\{0:0.00\} €}"
                                   FontFamily="Georgia" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Quantité"
                   FontFamily="Georgia" FontSize="13" Foreground="#231F20" Margin="0,0,0,4"/>
        <Border Background="#D4D4D4" CornerRadius="12" Width="80" Height="36"
                HorizontalAlignment="Left" Margin="0,0,0,15">
            <TextBox x:Name="TxtQuantite" Text="1" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" Padding="10,0" FontSize="14"
                     HorizontalContentAlignment="Center"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnAnnuler" Content="Annuler" Width="110" Height="38" Margin="0,0,10,0"
                    Foreground="White" Cursor="Hand" Click="BtnAnnuler_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#9B9B9B" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnAjouter" Content="Ajouter à la commande" Width="190" Height="38"
                    Foreground="White" Cursor="Hand" Click="BtnAjouter_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#3A7D3A" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
