<Window x:Class="SAE_Paul.uc.FenetreFicheClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Nouveau client" Height="473" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FAF4EB">
    <StackPanel Margin="30" VerticalAlignment="Center">

        <TextBlock Text="Nouveau client" FontFamily="Georgia" FontSize="22" FontWeight="Bold"
                   Foreground="#231F20" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Nom *" FontFamily="Georgia" FontSize="14" Foreground="Black" Margin="0,0,0,4"/>
        <Border Background="#D4D4D4" CornerRadius="12" Height="36" Margin="0,0,0,12">
            <TextBox x:Name="TxtNom" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" Padding="10,0" FontSize="14"/>
        </Border>

        <TextBlock Text="Prénom" FontFamily="Georgia" FontSize="14" Foreground="Black" Margin="0,0,0,4"/>
        <Border Background="#D4D4D4" CornerRadius="12" Height="36" Margin="0,0,0,12">
            <TextBox x:Name="TxtPrenom" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" Padding="10,0" FontSize="14"/>
        </Border>

        <TextBlock Text="Téléphone *" FontFamily="Georgia" FontSize="14" Foreground="Black" Margin="0,0,0,4"/>
        <Border Background="#D4D4D4" CornerRadius="12" Height="36" Margin="0,0,0,12">
            <TextBox x:Name="TxtTelephone" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" Padding="10,0" FontSize="14"/>
        </Border>

        <TextBlock Text="Mail" FontFamily="Georgia" FontSize="14" Foreground="Black" Margin="0,0,0,4"/>
        <Border Background="#D4D4D4" CornerRadius="12" Height="36" Margin="0,0,0,20">
            <TextBox x:Name="TxtMail" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" Padding="10,0" FontSize="14"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnAnnuler" Content="Annuler" Width="120" Height="38" Margin="0,0,10,0"
                    Cursor="Hand" Click="BtnAnnuler_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#9B9B9B" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnEnregistrer" Content="Enregistrer" Width="120" Height="38"
                    Foreground="White" Cursor="Hand" Click="BtnEnregistrer_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="#231F20" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
