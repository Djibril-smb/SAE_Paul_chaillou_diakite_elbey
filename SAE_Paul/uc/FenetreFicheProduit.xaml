<Window x:Class="SAE_Paul.uc.FenetreFicheProduit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Nouvelle taille" Height="300" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FAF4EB">
    <StackPanel Margin="25" VerticalAlignment="Center">

        <TextBlock Text="Nouvelle taille" FontFamily="Georgia" FontSize="20" FontWeight="Bold"
                   Foreground="#231F20" HorizontalAlignment="Center" Margin="0,0,0,18"/>

        <TextBlock Text="Nombre de parts *" FontFamily="Georgia" FontSize="13"
                   Foreground="Black" Margin="0,0,0,4"/>
        <Border Background="#D4D4D4" CornerRadius="12" Height="36" Margin="0,0,0,12">
            <TextBox x:Name="TxtNbParts" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" Padding="10,0" FontSize="14"/>
        </Border>

        <TextBlock Text="Prix (€) *" FontFamily="Georgia" FontSize="13"
                   Foreground="Black" Margin="0,0,0,4"/>
        <Border Background="#D4D4D4" CornerRadius="12" Height="36" Margin="0,0,0,18">
            <TextBox x:Name="TxtPrix" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" Padding="10,0" FontSize="14"/>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnAnnuler" Content="Annuler" Width="110" Height="38" Margin="0,0,10,0"
                    Foreground="White" Cursor="Hand" Click="BtnAnnuler_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#9B9B9B" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="BtnAjouter" Content="Ajouter" Width="110" Height="38"
                    Foreground="White" Cursor="Hand" Click="BtnAjouter_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#231F20" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
