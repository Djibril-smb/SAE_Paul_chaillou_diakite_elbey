<UserControl x:Class="SAE_Paul.uc.ucListeClients"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SAE_Paul.uc"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FAF4EB">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ligne 0 : bouton retour + titre -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Button x:Name="BtnRetour" Content="←" HorizontalAlignment="Left" VerticalAlignment="Center"
                    FontSize="28" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="BtnRetour_Click"/>
            <TextBlock Text="Clients" FontFamily="Georgia" FontSize="28" FontWeight="Bold"
                       Foreground="#231F20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Ligne 1 : barre de recherche + boutons Supprimer / Nouveau -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#D4D4D4" CornerRadius="15" Height="40" Margin="0,0,15,0">
                <TextBox x:Name="TxtRecherche" Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Center" Padding="12,0" FontSize="14"
                         TextChanged="TxtRecherche_TextChanged"/>
            </Border>

            <Button x:Name="BtnSupprimer" Grid.Column="1" Content="Supprimer"
                    Height="40" Width="120" Foreground="White" FontSize="14" Cursor="Hand"
                    Margin="0,0,10,0" Click="BtnSupprimer_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#B33A3A" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnNouveau" Grid.Column="2" Content="+ Nouveau client"
                    Height="40" Width="160" Foreground="White" FontSize="14" Cursor="Hand"
                    Click="BtnNouveau_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#231F20" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Ligne 2 : tableau des clients (double-clic = voir ses commandes) -->
        <DataGrid x:Name="GrilleClients" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" RowBackground="White" AlternatingRowBackground="#F3EDE3"
                  BorderBrush="#231F20" BorderThickness="1" FontSize="14"
                  SelectionMode="Single"
                  MouseDoubleClick="GrilleClients_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="*"/>
                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="*"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="*"/>
                <DataGridTextColumn Header="Mail" Binding="{Binding Mail}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
