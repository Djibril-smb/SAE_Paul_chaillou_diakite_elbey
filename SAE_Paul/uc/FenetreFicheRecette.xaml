<Window x:Class="SAE_Paul.uc.FenetreFicheRecette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Fiche recette" Height="700" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FAF4EB">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblTitre" Grid.Row="0" Text="Nouvelle recette"
                   FontFamily="Georgia" FontSize="22" FontWeight="Bold"
                   Foreground="#231F20" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ====== INFOS RECETTE ====== -->
                <TextBlock Text="Nom *" FontFamily="Georgia" FontSize="13"
                           Foreground="Black" Margin="0,0,0,4"/>
                <Border Background="#D4D4D4" CornerRadius="12" Height="36" Margin="0,0,0,12">
                    <TextBox x:Name="TxtNom" Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" Padding="10,0" FontSize="14"/>
                </Border>

                <TextBlock Text="Catégorie *" FontFamily="Georgia" FontSize="13"
                           Foreground="Black" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbCategorie" Height="36" FontSize="14"
                          DisplayMemberPath="CategorieNom" Margin="0,0,0,12"/>

                <TextBlock Text="Image" FontFamily="Georgia" FontSize="13"
                           Foreground="Black" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#231F20" Width="120" Height="90"
                            CornerRadius="10" ClipToBounds="True">
                        <Image x:Name="ApercuImage" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock x:Name="LblImageNom" Text="Aucune image"
                                   FontSize="12" Foreground="#666" TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnChoisirImage" Content="Choisir une image"
                                    Height="32" Padding="14,0" Foreground="White" FontSize="12"
                                    Cursor="Hand" Margin="0,0,8,0" Click="BtnChoisirImage_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#231F20" CornerRadius="16">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnRetirerImage" Content="Retirer"
                                    Height="32" Padding="14,0" Foreground="White" FontSize="12"
                                    Cursor="Hand" Click="BtnRetirerImage_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#9B9B9B" CornerRadius="16">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Description" FontFamily="Georgia" FontSize="13"
                           Foreground="Black" Margin="0,0,0,4"/>
                <Border Background="#D4D4D4" CornerRadius="12" Height="70" Margin="0,0,0,12">
                    <TextBox x:Name="TxtDescription" Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Top" Padding="10,8" FontSize="13"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>

                <!-- ====== ALLERGENES ====== -->
                <TextBlock Text="Allergènes" FontFamily="Georgia" FontSize="13"
                           Foreground="Black" Margin="0,0,0,4"/>
                <Border Background="#FFFDF7" BorderBrush="#D4D4D4" BorderThickness="1"
                        CornerRadius="8" Padding="10" Margin="0,0,0,15">
                    <ItemsControl x:Name="ListeAllergenes">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding AllergeneNom}"
                                          IsChecked="{Binding IsCochee, Mode=TwoWay}"
                                          Margin="0,2,18,2" Padding="4,0,0,0" FontSize="13"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ====== TAILLES (visible uniquement en edition) ====== -->
                <StackPanel x:Name="PanneauTailles" Visibility="Collapsed">
                    <Grid Margin="0,5,0,8">
                        <TextBlock Text="Tailles disponibles" FontFamily="Georgia" FontSize="15"
                                   FontWeight="Bold" Foreground="#231F20" VerticalAlignment="Center"/>
                        <Button x:Name="BtnAjouterTaille" Content="+ Ajouter une taille"
                                HorizontalAlignment="Right" Height="32" Width="170"
                                Foreground="White" FontSize="12" Cursor="Hand"
                                Click="BtnAjouterTaille_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#231F20" CornerRadius="16">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <DataGrid x:Name="GrilleTailles"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="White" RowBackground="White" AlternatingRowBackground="#F3EDE3"
                              BorderBrush="#231F20" BorderThickness="1" FontSize="13"
                              MinHeight="100" MaxHeight="200">
                        <!-- Ligne rouge clair quand la taille est indisponible. -->
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstIndisponible}" Value="True">
                                        <Setter Property="Background" Value="#FFE0E0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parts" Binding="{Binding NbParts}" Width="70"/>
                            <DataGridTextColumn Header="Prix"
                                                Binding="{Binding Prix, StringFormat=\{0:0.00\} €}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Disponible"
                                                    Binding="{Binding EstDisponible, Mode=OneWay}" Width="80"/>
                            <DataGridTemplateColumn Header="Actions" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <!-- Bouton "Marquer indispo" : visible si la taille est DISPONIBLE -->
                                            <Button Content="Marquer indispo" Tag="{Binding}"
                                                    Click="BtnBasculerDispo_Click"
                                                    Height="26" Padding="10,0" Cursor="Hand"
                                                    Foreground="White" FontSize="11" Margin="0,0,5,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstIndisponible}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#B89A4A" CornerRadius="13">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <!-- Bouton "Rendre dispo" : visible si la taille est INDISPONIBLE -->
                                            <Button Content="Rendre dispo" Tag="{Binding}"
                                                    Click="BtnBasculerDispo_Click"
                                                    Height="26" Padding="10,0" Cursor="Hand"
                                                    Foreground="White" FontSize="11" Margin="0,0,5,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EstIndisponible}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#3A7D3A" CornerRadius="13">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button Content="Supprimer" Tag="{Binding}"
                                                    Click="BtnSupprimerTaille_Click"
                                                    Height="26" Padding="8,0" Cursor="Hand"
                                                    Foreground="White" FontSize="11">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="#B33A3A" CornerRadius="13">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <TextBlock x:Name="LblAideCreation"
                           Text="Enregistre d'abord la recette pour pouvoir lui ajouter des tailles."
                           FontStyle="Italic" Foreground="#666" FontSize="12" Margin="0,8,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ====== BOUTONS BAS ====== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnSupprimerRecette" Content="Supprimer la recette"
                    Width="170" Height="38" Margin="0,0,10,0" Foreground="White"
                    Cursor="Hand" Click="BtnSupprimerRecette_Click"
                    Visibility="Collapsed">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#B33A3A" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnFermer" Content="Fermer"
                    Width="100" Height="38" Margin="0,0,10,0" Foreground="White"
                    Cursor="Hand" Click="BtnFermer_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#9B9B9B" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnEnregistrer" Content="Enregistrer"
                    Width="130" Height="38" Foreground="White"
                    Cursor="Hand" Click="BtnEnregistrer_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#3A7D3A" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
