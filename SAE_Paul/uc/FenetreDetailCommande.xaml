<Window x:Class="SAE_Paul.uc.FenetreDetailCommande"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Détail de la commande" Height="600" Width="780"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FAF4EB">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titre -->
        <TextBlock x:Name="LblTitre" Grid.Row="0" Text="Commande"
                   FontFamily="Georgia" FontSize="22" FontWeight="Bold"
                   Foreground="#231F20" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <!-- Bandeau statut -->
        <Border Grid.Row="1" Background="#F3EDE3" CornerRadius="12" Padding="15,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Statut :" FontFamily="Georgia" FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border x:Name="BadgePrete" Background="#9B9B9B" CornerRadius="12" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="Prête" Foreground="White" FontSize="12"/>
                    </Border>
                    <Border x:Name="BadgeRecuperee" Background="#9B9B9B" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="Récupérée" Foreground="White" FontSize="12"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="LblDateRetrait" Grid.Column="1" Text="Retrait le ..."
                           FontFamily="Georgia" FontSize="14" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Bandeau client + evenement -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Client" FontFamily="Georgia" FontSize="13"
                           Foreground="#666" Margin="0,0,0,2"/>
                <TextBlock x:Name="LblClient" Text="—" FontFamily="Georgia" FontSize="15"
                           FontWeight="Bold" Foreground="#231F20"/>
                <TextBlock x:Name="LblTelephone" Text="" FontFamily="Georgia" FontSize="13"
                           Foreground="#231F20" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="Événement" FontFamily="Georgia" FontSize="13"
                           Foreground="#666" Margin="0,0,0,2"/>
                <TextBlock x:Name="LblEvenement" Text="—" FontFamily="Georgia" FontSize="15"
                           FontWeight="Bold" Foreground="#231F20"/>
                <TextBlock x:Name="LblNbPersonne" Text="" FontFamily="Georgia" FontSize="13"
                           Foreground="#231F20" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Lignes de commande -->
        <DataGrid x:Name="GrilleLignes" Grid.Row="3"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" RowBackground="White" AlternatingRowBackground="#F3EDE3"
                  BorderBrush="#231F20" BorderThickness="1" FontSize="13"
                  MinHeight="180">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produit" Binding="{Binding Libelle}" Width="*"/>
                <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}" Width="60"/>
                <DataGridTextColumn Header="Prix u."
                                    Binding="{Binding PrixUnitaire, StringFormat=\{0:0.00\} €}" Width="80"/>
                <DataGridTextColumn Header="Sous-total"
                                    Binding="{Binding SousTotal, StringFormat=\{0:0.00\} €}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Totaux -->
        <Border Grid.Row="4" Background="#F3EDE3" CornerRadius="12" Padding="15" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Total" FontFamily="Georgia" FontSize="17"
                               FontWeight="Bold" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="LblTotal" Text="0.00 €" FontFamily="Georgia" FontSize="17"
                               FontWeight="Bold" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,5,0,0">
                    <TextBlock Text="Acompte" FontFamily="Georgia" FontSize="13"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="LblAcompte" Text="0.00 €" FontFamily="Georgia" FontSize="13"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Boutons d'action -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="BtnMarquerPrete" Content="Marquer prête"
                    Width="160" Height="38" Margin="0,0,10,0" Foreground="White"
                    FontSize="13" Cursor="Hand" Click="BtnMarquerPrete_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="#3A7D3A" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fond" Property="Background" Value="#C9C9C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnMarquerRecuperee" Content="Marquer récupérée"
                    Width="170" Height="38" Margin="0,0,10,0" Foreground="White"
                    FontSize="13" Cursor="Hand" Click="BtnMarquerRecuperee_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="#3A7D3A" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Fond" Property="Background" Value="#C9C9C9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnFermer" Content="Fermer"
                    Width="110" Height="38" Foreground="White"
                    FontSize="13" Cursor="Hand" Click="BtnFermer_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#231F20" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
