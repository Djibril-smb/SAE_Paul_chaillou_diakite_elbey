<Window x:Class="SAE_Paul.uc.FenetreCommandesClient"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Commandes du client" Height="500" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FAF4EB">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblTitre" Grid.Row="0" Text="Commandes du client"
                   FontFamily="Georgia" FontSize="22" FontWeight="Bold"
                   Foreground="#231F20" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <DataGrid x:Name="GrilleCommandes" Grid.Row="1"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" RowBackground="White" AlternatingRowBackground="#F3EDE3"
                  BorderBrush="#231F20" BorderThickness="1" FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N°" Binding="{Binding CommandeId}" Width="50"/>
                <DataGridTextColumn Header="Créée le"
                                    Binding="{Binding DateCreation, StringFormat=\{0:dd/MM/yyyy\}}" Width="*"/>
                <DataGridTextColumn Header="Retrait"
                                    Binding="{Binding DateRetrait, StringFormat=\{0:dd/MM/yyyy\}}" Width="*"/>
                <DataGridTextColumn Header="Événement" Binding="{Binding CategorieEvenementNom}" Width="*"/>
                <DataGridTextColumn Header="Date évén."
                                    Binding="{Binding DateEvenement, StringFormat=\{0:dd/MM/yyyy\}}" Width="*"/>
                <DataGridTextColumn Header="Pers." Binding="{Binding NbPersonne}" Width="60"/>
                <DataGridTextColumn Header="Total"
                                    Binding="{Binding Total, StringFormat=\{0:0.00\} €}" Width="80"/>
                <DataGridTextColumn Header="Acompte"
                                    Binding="{Binding Acompte, StringFormat=\{0:0.00\} €}" Width="80"/>
                <DataGridCheckBoxColumn Header="Prête" Binding="{Binding EstPrete}" Width="60"/>
                <DataGridCheckBoxColumn Header="Récup." Binding="{Binding EstRecuperee}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="LblVide" Grid.Row="1" Text="Aucune commande pour ce client."
                   FontFamily="Georgia" FontSize="14" Foreground="#666"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <Button x:Name="BtnFermer" Grid.Row="2" Content="Fermer"
                Width="120" Height="38" Margin="0,15,0,0"
                HorizontalAlignment="Right" Foreground="White" Cursor="Hand"
                Click="BtnFermer_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="#231F20" CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
