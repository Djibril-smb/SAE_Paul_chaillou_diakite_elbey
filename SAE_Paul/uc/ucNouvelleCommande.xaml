<UserControl x:Class="SAE_Paul.uc.ucNouvelleCommande"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SAE_Paul.uc"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FAF4EB">
    <UserControl.Resources>
        <Style x:Key="StyleLibelle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#231F20"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="StyleSection" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#231F20"/>
            <Setter Property="Margin" Value="0,5,0,8"/>
        </Style>
        <!-- Pill creme/noir pour les filtres de categorie. -->
        <Style x:Key="StylePill" TargetType="Button">
            <Setter Property="Foreground" Value="#231F20"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="#F3EDE3" BorderBrush="#231F20"
                                BorderThickness="1.5" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="ON">
                                <Setter TargetName="Fond" Property="Background" Value="#231F20"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Button x:Name="BtnRetour" Content="←" HorizontalAlignment="Left" VerticalAlignment="Center"
                    FontSize="28" Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="BtnRetour_Click"/>
            <TextBlock Text="Nouvelle commande" FontFamily="Georgia" FontSize="26" FontWeight="Bold"
                       Foreground="#231F20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ============ CLIENT ============ -->
                <TextBlock Text="Client *" Style="{StaticResource StyleSection}"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#D4D4D4" CornerRadius="12" Height="38" Margin="0,0,10,0">
                        <TextBlock x:Name="LblClient" Text="Aucun client choisi"
                                   VerticalAlignment="Center" Padding="12,0" FontSize="14" Foreground="#666"/>
                    </Border>
                    <Button x:Name="BtnChoisirClient" Grid.Column="1" Content="Choisir un client"
                            Width="160" Height="38" Foreground="White" FontSize="14" Cursor="Hand"
                            Click="BtnChoisirClient_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#231F20" CornerRadius="18">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ============ EVENEMENT ============ -->
                <TextBlock Text="Événement (facultatif)" Style="{StaticResource StyleSection}"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Type" Style="{StaticResource StyleLibelle}"/>
                        <ComboBox x:Name="CmbEvenement" Height="36" FontSize="14"
                                  DisplayMemberPath="CategorieEvenementNom"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Nombre de personnes" Style="{StaticResource StyleLibelle}"/>
                        <Border Background="#D4D4D4" CornerRadius="12" Height="36">
                            <TextBox x:Name="TxtNbPersonne" Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" Padding="10,0" FontSize="14"
                                     HorizontalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============ DATE RETRAIT ============ -->
                <TextBlock Text="Date de retrait *" Style="{StaticResource StyleSection}"/>
                <DatePicker x:Name="DpDateRetrait" Height="36" Width="200"
                            HorizontalAlignment="Left" FontSize="14" Margin="0,0,0,20"/>

                <!-- ============ PRODUITS (cartes a la Figma) ============ -->
                <TextBlock Text="Produits" Style="{StaticResource StyleSection}"/>

                <!-- Barre de filtres categorie -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button x:Name="BtnCatTout" Content="Tout" Tag="ON"
                            Style="{StaticResource StylePill}" Click="BtnCategorie_Click"/>
                    <Button x:Name="BtnCatGateaux" Content="Gâteaux"
                            Style="{StaticResource StylePill}" Click="BtnCategorie_Click"/>
                    <Button x:Name="BtnCatViennoiseries" Content="Viennoiseries"
                            Style="{StaticResource StylePill}" Click="BtnCategorie_Click"/>
                    <Button x:Name="BtnCatPains" Content="Pains"
                            Style="{StaticResource StylePill}" Click="BtnCategorie_Click"/>
                </StackPanel>

                <!-- Barre de recherche -->
                <Border Background="#D4D4D4" CornerRadius="15" Height="36" Margin="0,0,0,10">
                    <TextBox x:Name="TxtRechercheProduit" Background="Transparent" BorderThickness="0"
                             VerticalAlignment="Center" Padding="14,0" FontSize="13"
                             TextChanged="TxtRechercheProduit_TextChanged"/>
                </Border>
                <TextBlock Text="Cliquez sur une recette pour choisir la taille et la quantité."
                           FontStyle="Italic" Foreground="#666" Margin="0,0,0,8" FontSize="12"/>

                <!-- Cartes produits -->
                <Border Background="#FFFDF7" BorderBrush="#231F20" BorderThickness="1" CornerRadius="12">
                    <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" Padding="8">
                        <ItemsControl x:Name="ListeProduits">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="170" Height="200" Margin="6" Cursor="Hand"
                                            Click="CarteRecette_Click"
                                            Background="Transparent" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Fond" Background="#F3EDE3"
                                                        BorderBrush="#231F20" BorderThickness="1.5"
                                                        CornerRadius="14">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.2"/>
                                                    </Border.Effect>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="110"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Background="#231F20"
                                                                CornerRadius="13,13,0,0" ClipToBounds="True">
                                                            <Image Source="{Binding ImagePath}" Stretch="Uniform"/>
                                                        </Border>
                                                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="8">
                                                            <TextBlock Text="{Binding RecetteNom}" Foreground="#231F20"
                                                                       FontSize="13" FontWeight="Bold" FontFamily="Georgia"
                                                                       TextWrapping="Wrap" TextAlignment="Center"/>
                                                            <TextBlock Text="{Binding CategorieNom}" FontSize="10"
                                                                       Foreground="#666" HorizontalAlignment="Center"
                                                                       Margin="0,2,0,2"/>
                                                            <TextBlock Text="{Binding LibellePrix}" Foreground="#231F20"
                                                                       FontSize="11" FontWeight="Bold"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Fond" Property="BorderThickness" Value="2.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- ============ RECAP ============ -->
                <TextBlock Text="Récapitulatif" Style="{StaticResource StyleSection}"/>

                <DataGrid x:Name="GrilleLignes"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="White" RowBackground="White" AlternatingRowBackground="#F3EDE3"
                          BorderBrush="#231F20" BorderThickness="1" FontSize="13"
                          MinHeight="80" MaxHeight="180" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Produit" Binding="{Binding Libelle}" Width="*"/>
                        <DataGridTextColumn Header="Qté" Binding="{Binding Quantite}" Width="60"/>
                        <DataGridTextColumn Header="Prix u."
                                            Binding="{Binding PrixUnitaire, StringFormat=\{0:0.00\} €}" Width="80"/>
                        <DataGridTextColumn Header="Sous-total"
                                            Binding="{Binding SousTotal, StringFormat=\{0:0.00\} €}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button x:Name="BtnRetirer" Content="Retirer la ligne sélectionnée"
                        Height="32" Width="220" HorizontalAlignment="Right" Margin="0,8,0,15"
                        Foreground="White" FontSize="13" Cursor="Hand" Click="BtnRetirer_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#B33A3A" CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- ============ TOTAUX ============ -->
                <Border Background="#F3EDE3" CornerRadius="12" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Total" FontFamily="Georgia" FontSize="18"
                                       FontWeight="Bold" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="LblTotal" Text="0.00 €" FontFamily="Georgia" FontSize="18"
                                       FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,5,0,0">
                            <TextBlock Text="Acompte (Total / 4)" FontFamily="Georgia" FontSize="14"
                                       HorizontalAlignment="Left"/>
                            <TextBlock x:Name="LblAcompte" Text="0.00 €" FontFamily="Georgia" FontSize="14"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ VALIDER ============ -->
                <Button x:Name="BtnValider" Content="Valider la commande"
                        Height="44" Width="240" HorizontalAlignment="Right" Margin="0,0,0,20"
                        Foreground="White" FontSize="15" Cursor="Hand" Click="BtnValider_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#3A7D3A" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
