<UserControl x:Class="SAE_Paul.uc.ucPageAccueilVendeur"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SAE_Paul"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FAF4EB">
    <Grid Margin="30">
        <Grid VerticalAlignment="Top" Height="100">
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" 
                    Background="#231F20" Width="100" Height="100" CornerRadius="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="PAUL" Foreground="#FAF4EB" FontSize="26" FontFamily="Georgia" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="MAISON DE QUALITÉ" Foreground="#FAF4EB" FontSize="6" FontFamily="Georgia" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Button x:Name="BtnProfil" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="60" Height="60" Cursor="Hand" Click="BtnProfil_Click" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#231F20"/>

                            <Image Source="/img/deconnexion.png" 
                                   Margin="12" 
                                   Stretch="Uniform"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="650" Height="160" Margin="0,50,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnProduits" Grid.Column="0" Margin="15,0" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#231F20" CornerRadius="25">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="Produits" Foreground="White" FontSize="22" FontFamily="Georgia" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnCommandes" Grid.Column="1" Margin="15,0" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#231F20" CornerRadius="25">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="Commandes" Foreground="White" FontSize="22" FontFamily="Georgia" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="BtnClients" Grid.Column="2" Margin="15,0" Click="BtnClients_Click" >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#231F20" CornerRadius="25">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <TextBlock Text="clients" Foreground="White" FontSize="22" FontFamily="Georgia" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>